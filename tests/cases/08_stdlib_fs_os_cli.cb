' EXPECT_OUT: exists=true
' EXPECT_OUT: content=hello stdlib
' EXPECT_OUT: files=1
' EXPECT_OUT: envNonEmpty=true
' EXPECT_OUT: exec=0:hello-exec
' EXPECT_OUT: json=ok:42:true
' EXPECT_OUT: cli=true:res.txt:myPat:false
' EXPECT_OUT: cliHelp=true
' EXPECT_OUT: paths=true:false:hello.txt:/tmp/cb_test_08_dir:.txt
' EXPECT_OUT: cwdNonEmpty=true
' EXPECT_OUT: strMethods=true:true:6:-1:hello-stdlib
' EXPECT_OUT: regex=true:12:12,34:aXbX:true

import "std/fs"
import "std/os"
import "std/json"
import "std/cli"
import "std/regex"

fn main() as int
    dim dir = "/tmp/cb_test_08_dir"
    dim file = dir & "/hello.txt"

    try
        fs.mkdirAll(dir)
        fs.writeFile(file, "hello stdlib")
        print("exists=" & fs.exists(file))
        dim text = fs.readFile(file)
        print("content=" & text)
        dim entries = fs.listDir(dir)
        print("files=" & entries.len())
    catch e
        print("fs error: " & e.msg)
        return 1
    end try

    dim argsList = os.args()
    dim argc = argsList.len()
    if argc < 0
        return 1
    end if
    dim pathEnv = os.getEnv("PATH")
    print("envNonEmpty=" & (pathEnv.len() > 0))

    try
        dim res = os.exec("echo", ["hello-exec"])
        print("exec=" & res.exitCode & ":" & res.stdout.trim())
    catch e
        print("exec error: " & e.msg)
        return 1
    end try

    dim rawJson = json.stringify({"name": "ok", "count": "42"})
    try
        dim jv = json.parse(rawJson)
        print("json=" & jv.get("name").asStr() & ":" & jv.get("count").asInt() & ":" & jv.has("name"))
    catch e
        print("json error: " & e.msg)
        return 1
    end try

    dim p = cli.newParser(name="cbgrep", version="1.0", description="Search files")
    p.addFlag("ignore-case", "i", "Case-insensitive")
    p.addOption("output", "o", "Output path", "out.txt")
    p.addArg("pattern", "Search pattern")

    try
        dim parsed = p.parseArgs(["-i", "--output", "res.txt", "myPat"])
        print("cli=" & parsed.hasFlag("ignore-case") & ":" & parsed.getOption("output") & ":" & parsed.getArg("pattern") & ":" & parsed.helpRequested)

        dim helpParsed = p.parseArgs(["--help"])
        print("cliHelp=" & helpParsed.helpRequested)
    catch e
        print("cli error: " & e.msg)
        return 1
    end try

    dim joined = fs.join(dir, "hello.txt")
    print("paths=" & fs.isDir(dir) & ":" & fs.isDir(joined) & ":" & fs.base(joined) & ":" & fs.dir(joined) & ":" & fs.ext(joined))

    try
        dim cwd = os.cwd()
        print("cwdNonEmpty=" & (cwd.len() > 0))
    catch e
        print("cwd error: " & e.msg)
        return 1
    end try

    dim sample = "hello_stdlib"
    print("strMethods=" & sample.startsWith("hello") & ":" & sample.endsWith("stdlib") & ":" & sample.indexOf("stdlib") & ":" & sample.indexOf("missing") & ":" & sample.replace("_", "-"))

    try
        dim re = regex.compile("[0-9]+")
        dim directMatch = regex.match("^a[0-9]+", "a12b34")
        print("regex=" & re.isMatch("a12b34") & ":" & re.find("a12b34") & ":" & str.join(re.findAll("a12b34"), ",") & ":" & re.replaceAll("a12b34", "X") & ":" & directMatch)
    catch e
        print("regex error: " & e.msg)
        return 1
    end try

    return 0
end fn
