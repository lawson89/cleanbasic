// EXPECT_OUT: exists=true
// EXPECT_OUT: content=hello stdlib
// EXPECT_OUT: files=1
// EXPECT_OUT: envNonEmpty=true
// EXPECT_OUT: exec=0:hello-exec
// EXPECT_OUT: cli=true:res.txt:myPat:false
// EXPECT_OUT: cliBundled=true:bundle.txt:p2
// EXPECT_OUT: cliUtf8=true:αβ
// EXPECT_OUT: cliLong=true:my.toml
// EXPECT_OUT: cliHelp=true
// EXPECT_OUT: paths=true:false:hello.txt:/tmp/cb_test_08_dir:.txt
// EXPECT_OUT: cwdNonEmpty=true
// EXPECT_OUT: exeNonEmpty=true
// EXPECT_OUT: rel=hello.txt
// EXPECT_OUT: cacheDirNonEmpty=true
// EXPECT_OUT: execInDir=0:7
// EXPECT_OUT: strMethods=true:true:6:-1:hello-stdlib
// EXPECT_OUT: regex=true:12:12,34:aXbX:true
// EXPECT_OUT: tempIn=true
// EXPECT_OUT: writeStdout=ab
// EXPECT_OUT: sorted=alpha,beta,gamma:1,2,3
// EXPECT_OUT: structDict=10:20
// EXPECT_OUT: platformNonEmpty=true
// EXPECT_OUT: atomic=v1:v1:v2:true
// EXPECT_OUT: rename=false:true:v2

import "std/fs"
import "std/os"
import "std/cli"
import "std/regex"

type Bag
    scores as dict[str, int]
end type

fn main() as int
    dim dir = "/tmp/cb_test_08_dir"
    dim file = dir + "/hello.txt"

    try
        fs.mkdirAll(dir)
        fs.writeFile(file, "hello stdlib")
        print("exists=" + fs.exists(file).toStr())
        dim text = fs.readFile(file)
        print("content=" + text)
        dim entries = fs.listDir(dir)
        print("files=" + entries.len().toStr())
    catch e
        print("fs error: " + e.msg)
        return 1
    end try

    dim argsList = os.args()
    dim argc = argsList.len()
    if argc < 0
        return 1
    end if
    dim pathEnv = os.getEnv("PATH")
    print("envNonEmpty=" + (pathEnv.len() > 0).toStr())

    try
        dim res = os.exec("echo", ["hello-exec"])
        print("exec=" + res.exitCode.toStr() + ":" + res.stdout.trim())
    catch e
        print("exec error: " + e.msg)
        return 1
    end try

    dim p = cli.newParser("cbgrep", "1.0", "Search files")
    p.addFlag("ignore-case", "i", "Case-insensitive")
    p.addOption("output", "o", "Output path", "out.txt")
    p.addArg("pattern", "Search pattern")

    try
        dim parsed = p.parseArgs(["-i", "--output", "res.txt", "myPat"])
        print("cli=" + parsed.hasFlag("ignore-case").toStr() + ":" + parsed.getOption("output") + ":" + parsed.getArg("pattern") + ":" + parsed.helpRequested.toStr())

        dim bundled = p.parseArgs(["-iobundle.txt", "p2"])
        print("cliBundled=" + bundled.hasFlag("ignore-case").toStr() + ":" + bundled.getOption("output") + ":" + bundled.getArg("pattern"))

        dim pUtf8 = cli.newParser("u", "1.0", "UTF-8 test")
        pUtf8.addFlag("alpha", "α", "Alpha flag")
        pUtf8.addOption("beta", "β", "Beta opt", "def")
        dim utf8Parsed = pUtf8.parseArgs(["-αβαβ"])
        print("cliUtf8=" + utf8Parsed.hasFlag("alpha").toStr() + ":" + utf8Parsed.getOption("beta"))

        dim pLong = cli.newParser("longonly", "1.0", "")
        pLong.addFlag("verbose", "", "Verbose output")
        pLong.addOption("config", "", "Config file", "cfg.toml")
        dim longParsed = pLong.parseArgs(["--verbose", "--config", "my.toml"])
        print("cliLong=" + longParsed.hasFlag("verbose").toStr() + ":" + longParsed.getOption("config"))

        dim helpParsed = p.parseArgs(["--help"])
        print("cliHelp=" + helpParsed.helpRequested.toStr())
    catch e
        print("cli error: " + e.msg)
        return 1
    end try

    dim joined = fs.join(dir, "hello.txt")
    print("paths=" + fs.isDir(dir).toStr() + ":" + fs.isDir(joined).toStr() + ":" + fs.base(joined) + ":" + fs.dir(joined) + ":" + fs.ext(joined))

    try
        dim cwd = os.cwd()
        print("cwdNonEmpty=" + (cwd.len() > 0).toStr())
        dim exePath = os.executable()
        print("exeNonEmpty=" + (exePath.len() > 0).toStr())
        dim relPath = fs.rel(dir, file)
        print("rel=" + relPath)
    catch e
        print("cwd error: " + e.msg)
        return 1
    end try

    dim cdir = os.cacheDir()
    print("cacheDirNonEmpty=" + (cdir.len() > 0).toStr())

    try
        dim ec0 = os.execInDir(dir, "sh", ["-c", "test -f hello.txt"])
        dim ec7 = os.execInDir(dir, "sh", ["-c", "exit 7"])
        print("execInDir=" + ec0.toStr() + ":" + ec7.toStr())
    catch e
        print("execInDir error: " + e.msg)
        return 1
    end try

    dim sample = "hello_stdlib"
    print("strMethods=" + sample.startsWith("hello").toStr() + ":" + sample.endsWith("stdlib").toStr() + ":" + sample.indexOf("stdlib").toStr() + ":" + sample.indexOf("missing").toStr() + ":" + sample.replace("_", "-"))

    try
        dim re = regex.compile("[0-9]+")
        dim directMatch = regex.match("^a[0-9]+", "a12b34")
        print("regex=" + re.isMatch("a12b34").toStr() + ":" + re.find("a12b34") + ":" + re.findAll("a12b34").join(",") + ":" + re.replaceAll("a12b34", "X") + ":" + directMatch.toStr())
    catch e
        print("regex error: " + e.msg)
        return 1
    end try

    try
        dim tmpSub = fs.mkdirTempIn(dir, "job-*")
        dim isSubDir = fs.isDir(tmpSub)
        dim inDir = fs.dir(tmpSub) == dir
        fs.removeAll(tmpSub)
        print("tempIn=" + (isSubDir and inDir).toStr())
    catch e
        print("mkdirTempIn error: " + e.msg)
        return 1
    end try

    os.writeStdout("writeStdout=a")
    os.writeStdout("b\n")

    dim words = ["gamma", "alpha", "beta"]
    words.sort()
    dim nums = [3, 1, 2]
    nums.sort()
    print("sorted=" + words.join(",") + ":" + nums[0].toStr() + "," + nums[1].toStr() + "," + nums[2].toStr())

    dim bag1 as Bag
    bag1.scores["x"] = 10
    dim bag2 = Bag()
    bag2.scores["y"] = 20
    print("structDict=" + bag1.scores["x"].toStr() + ":" + bag2.scores["y"].toStr())

    print("platformNonEmpty=" + (os.platform().len() > 0).toStr())

    dim atomicDir = dir + "/atomic_sub"
    dim atomicFile = atomicDir + "/data.txt"
    dim renamedFile = atomicDir + "/moved.txt"
    try
        fs.mkdirAll(atomicDir)
        fs.writeFileAtomic(atomicFile, "v1")
        dim a1 = fs.readFile(atomicFile)
        fs.writeFileAtomic(atomicFile, "v1")
        dim a2 = fs.readFile(atomicFile)
        fs.writeFileAtomic(atomicFile, "v2")
        dim a3 = fs.readFile(atomicFile)
        dim atomicEntries = fs.listDir(atomicDir)
        dim noLeftoverTmp = atomicEntries.len() == 1 and atomicEntries[0] == "data.txt"
        print("atomic=" + a1 + ":" + a2 + ":" + a3 + ":" + noLeftoverTmp.toStr())

        fs.rename(atomicFile, renamedFile)
        dim oldGone = fs.exists(atomicFile)
        dim newExists = fs.exists(renamedFile)
        dim movedContent = fs.readFile(renamedFile)
        print("rename=" + oldGone.toStr() + ":" + newExists.toStr() + ":" + movedContent)
        fs.removeAll(atomicDir)
    catch e
        print("atomic/rename error: " + e.msg)
        return 1
    end try

    return 0
end fn
