// EXPECT_OUT: exists=true
// EXPECT_OUT: content=hello stdlib
// EXPECT_OUT: files=1
// EXPECT_OUT: envNonEmpty=true
// EXPECT_OUT: exec=0:hello-exec
// EXPECT_OUT: cli=true:res.txt:myPat:false
// EXPECT_OUT: cliHelp=true
// EXPECT_OUT: paths=true:false:hello.txt:/tmp/cb_test_08_dir:.txt
// EXPECT_OUT: cwdNonEmpty=true
// EXPECT_OUT: cacheDirNonEmpty=true
// EXPECT_OUT: execInDir=0:7
// EXPECT_OUT: strMethods=true:true:6:-1:hello-stdlib
// EXPECT_OUT: regex=true:12:12,34:aXbX:true

import "std/fs"
import "std/os"
import "std/cli"
import "std/regex"

fn main() as int
    dim dir = "/tmp/cb_test_08_dir"
    dim file = dir + "/hello.txt"

    try
        fs.mkdirAll(dir)
        fs.writeFile(file, "hello stdlib")
        print("exists=" + fs.exists(file).toStr())
        dim text = fs.readFile(file)
        print("content=" + text)
        dim entries = fs.listDir(dir)
        print("files=" + entries.len().toStr())
    catch e
        print("fs error: " + e.msg)
        return 1
    end try

    dim argsList = os.args()
    dim argc = argsList.len()
    if argc < 0
        return 1
    end if
    dim pathEnv = os.getEnv("PATH")
    print("envNonEmpty=" + (pathEnv.len() > 0).toStr())

    try
        dim res = os.exec("echo", ["hello-exec"])
        print("exec=" + res.exitCode.toStr() + ":" + res.stdout.trim())
    catch e
        print("exec error: " + e.msg)
        return 1
    end try

    dim p = cli.newParser("cbgrep", "1.0", "Search files")
    p.addFlag("ignore-case", "i", "Case-insensitive")
    p.addOption("output", "o", "Output path", "out.txt")
    p.addArg("pattern", "Search pattern")

    try
        dim parsed = p.parseArgs(["-i", "--output", "res.txt", "myPat"])
        print("cli=" + parsed.hasFlag("ignore-case").toStr() + ":" + parsed.getOption("output") + ":" + parsed.getArg("pattern") + ":" + parsed.helpRequested.toStr())

        dim helpParsed = p.parseArgs(["--help"])
        print("cliHelp=" + helpParsed.helpRequested.toStr())
    catch e
        print("cli error: " + e.msg)
        return 1
    end try

    dim joined = fs.join(dir, "hello.txt")
    print("paths=" + fs.isDir(dir).toStr() + ":" + fs.isDir(joined).toStr() + ":" + fs.base(joined) + ":" + fs.dir(joined) + ":" + fs.ext(joined))

    try
        dim cwd = os.cwd()
        print("cwdNonEmpty=" + (cwd.len() > 0).toStr())
    catch e
        print("cwd error: " + e.msg)
        return 1
    end try

    dim cdir = os.cacheDir()
    print("cacheDirNonEmpty=" + (cdir.len() > 0).toStr())

    try
        dim ec0 = os.execInDir(dir, "sh", ["-c", "test -f hello.txt"])
        dim ec7 = os.execInDir(dir, "sh", ["-c", "exit 7"])
        print("execInDir=" + ec0.toStr() + ":" + ec7.toStr())
    catch e
        print("execInDir error: " + e.msg)
        return 1
    end try

    dim sample = "hello_stdlib"
    print("strMethods=" + sample.startsWith("hello").toStr() + ":" + sample.endsWith("stdlib").toStr() + ":" + sample.indexOf("stdlib").toStr() + ":" + sample.indexOf("missing").toStr() + ":" + sample.replace("_", "-"))

    try
        dim re = regex.compile("[0-9]+")
        dim directMatch = regex.match("^a[0-9]+", "a12b34")
        print("regex=" + re.isMatch("a12b34").toStr() + ":" + re.find("a12b34") + ":" + re.findAll("a12b34").join(",") + ":" + re.replaceAll("a12b34", "X") + ":" + directMatch.toStr())
    catch e
        print("regex error: " + e.msg)
        return 1
    end try

    return 0
end fn
