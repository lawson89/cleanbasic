// EXPECT_OUT: status: Active
// EXPECT_OUT: circle area: 75
// EXPECT_OUT: rect area: 24
// EXPECT_OUT: empty area: 0

enum Status
    Pending
    Active
    Closed
end enum

enum ShapeKind
    Circle
    Rect
    Empty
end enum

type Shape
    kind as ShapeKind
    radius as int
    width as int
    height as int
end type

fn calcArea(s as Shape) as int
    select case s.kind
        case ShapeKind.Circle
            return 3 * s.radius * s.radius
        case ShapeKind.Rect
            return s.width * s.height
        case else
            return 0
    end select
end fn

fn main() as int
    dim st = Status.Active
    select case st
        case Status.Active
            print("status: Active")
        case else
            print("status: Other")
    end select

    dim s1 = Shape(ShapeKind.Circle, 5, 0, 0)
    dim s2 = Shape(ShapeKind.Rect, 0, 4, 6)
    dim s3 = Shape(ShapeKind.Empty, 0, 0, 0)

    print("circle area: " + calcArea(s1).toStr())
    print("rect area: " + calcArea(s2).toStr())
    print("empty area: " + calcArea(s3).toStr())
    return 0
end fn
