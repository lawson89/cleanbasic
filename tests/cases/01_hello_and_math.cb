' EXPECT_OUT: arithmetic: count=3
' EXPECT_OUT: logic: true

fn main() as int
    const base = 10
    dim x = base + 5
    x = x - 3
    x = x * 4
    x = x / 6
    x = x % 5

    dim msg = "count=" & x
    print("arithmetic: " & msg)

    dim ok = (x == 3) and not (x > 10) or false
    print("logic: ", ok)
    return 0
end fn