// EXPECT_OUT: leaf zero=0 len=0
// EXPECT_OUT: isolation orig=10 copy=10
// EXPECT_OUT: nested=99 byref=55
// EXPECT_OUT: mutual=77
// EXPECT_OUT: count=2 val=10
// EXPECT_OUT: pool sum=60
// EXPECT_OUT: drain=100,200,300
// EXPECT_OUT: done=true

type TreeNode
    val as int
    hasNext as bool
    children as list[TreeNode]
end type

type Expr
    tag as int
    blocks as list[Block]
end type

type Block
    num as int
    exprs as list[Expr]
end type

fn bumpVal(byref n as TreeNode, v as int)
    n.val = v
end fn

fn worker(id as int, tasks as mailbox[int], results as mailbox[int], done as mailbox[bool])
    for item in tasks
        results.post(item * 2)
    end for
    done.post(true)
end fn

fn quickWorker(x as int, outBox as mailbox[int])
    outBox.post(x + 1)
end fn

fn main() as int
    // 1. Pure value struct zero-initialization, value-copy isolation, nested mutation, byref
    dim empty = TreeNode()
    print("leaf zero=" + empty.val.toStr() + " len=" + empty.children.len().toStr())
    dim child = TreeNode()
    child.val = 10
    dim parent = TreeNode()
    parent.val = 1
    parent.children.push(child)
    child.val = 999
    print("isolation orig=10 copy=" + parent.children[0].val.toStr())

    dim grand = TreeNode()
    grand.val = 99
    parent.children[0].children.push(grand)
    dim firstChild = parent.children[0]
    bumpVal(firstChild, 55)
    parent.children[0] = firstChild
    print("nested=" + parent.children[0].children[0].val.toStr() + " byref=" + parent.children[0].val.toStr())

    // 2. Mutually recursive structs via list[T]
    dim e = Expr()
    e.tag = 1
    dim blk = Block()
    dim inner = Expr()
    inner.tag = 77
    blk.exprs.push(inner)
    e.blocks.push(blk)
    print("mutual=" + e.blocks[0].exprs[0].tag.toStr())

    // 3. Buffered mailbox post, count, get, close
    dim mb = mailbox[int](2)
    mb.post(10)
    mb.post(20)
    print("count=" + mb.count().toStr() + " val=" + mb.get().toStr())
    mb.get()
    mb.close()

    // 4. Worker pool with mailbox[T] and start job statement
    dim tasks = mailbox[int]()
    dim results = mailbox[int](8)
    dim done = mailbox[bool](2)
    for w = 1 to 2
        start job worker(w, tasks, results, done)
    end for

    tasks.post(5)
    tasks.post(10)
    tasks.post(15)
    tasks.close()

    for w = 1 to 2
        done.get()
    end for
    results.close()

    dim sum = 0
    for r in results
        sum = sum + r
    end for
    print("pool sum=" + sum.toStr())

    // 5. Mailbox for-in drain & single start job communication
    dim q = mailbox[int](4)
    q.post(100)
    q.post(200)
    q.post(300)
    q.close()
    dim parts = list[str]()
    for msg in q
        parts.push(msg.toStr())
    end for
    print("drain=" + str.join(parts, ","))

    dim qOutBox = mailbox[int](1)
    start job quickWorker(41, qOutBox)
    dim qOut = qOutBox.get()
    print("done=" + (qOut == 42).toStr())

    return 0
end fn
