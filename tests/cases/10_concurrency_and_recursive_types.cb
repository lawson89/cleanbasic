// EXPECT_OUT: leaf zero=0 len=0
// EXPECT_OUT: isolation orig=10 copy=10
// EXPECT_OUT: nested=99 byref=55
// EXPECT_OUT: mutual=77
// EXPECT_OUT: pool sum=60
// EXPECT_OUT: list_ret=3:60
// EXPECT_OUT: dict_ret=1:42
// EXPECT_OUT: eager=100
// EXPECT_OUT: zero_wait=0
// EXPECT_OUT: repeat=42:42
// EXPECT_OUT: void_done=true
// EXPECT_OUT: is_done=true:true
// EXPECT_OUT: fast_timeout=42:void_ok
// EXPECT_OUT: cancel_timeout=false:true:99:true
// EXPECT_OUT: fanout_cancel=true:11:21

type TreeNode
    val as int
    hasNext as bool
    children as list[TreeNode]
end type

type Expr
    tag as int
    blocks as list[Block]
end type

type Block
    num as int
    exprs as list[Expr]
end type

type BoxedPair
    a as int
    b as int
end type

type WorkerConfig
    id as int
    tok as cancelToken
end type

fn bumpVal(byref n as TreeNode, v as int)
    n.val = v
end fn

fn doubleVal(x as int) as int
    return x * 2
end fn

fn makeScaledList(base as int) as list[int]
    dim out = list[int]()
    out.push(base * 1)
    out.push(base * 2)
    out.push(base * 3)
    return out
end fn

fn buildSummary(p as BoxedPair) as dict[str, int]
    dim d = dict[str, int]()
    d["sum"] = p.a + p.b
    return d
end fn

fn addOne(x as int) as int
    return x + 1
end fn

fn touchVoid()
end fn

fn waitForCancel(tok as cancelToken) as int
    while not tok.isCanceled()
    end while
    return 99
end fn

fn fanoutWorker(cfg as WorkerConfig) as int
    while not cfg.tok.isCanceled()
    end while
    return cfg.id
end fn

fn main() as int
    // 1. Pure value struct zero-initialization, value-copy isolation, nested mutation, byref
    dim empty = TreeNode()
    print("leaf zero=" + empty.val.toStr() + " len=" + empty.children.len().toStr())
    dim child = TreeNode()
    child.val = 10
    dim parent = TreeNode()
    parent.val = 1
    parent.children.push(child)
    child.val = 999
    print("isolation orig=10 copy=" + parent.children[0].val.toStr())

    dim grand = TreeNode()
    grand.val = 99
    parent.children[0].children.push(grand)
    dim firstChild = parent.children[0]
    bumpVal(firstChild, 55)
    parent.children[0] = firstChild
    print("nested=" + parent.children[0].children[0].val.toStr() + " byref=" + parent.children[0].val.toStr())

    // 2. Mutually recursive structs via list[T]
    dim e = Expr()
    e.tag = 1
    dim blk = Block()
    dim inner = Expr()
    inner.tag = 77
    blk.exprs.push(inner)
    e.blocks.push(blk)
    print("mutual=" + e.blocks[0].exprs[0].tag.toStr())

    // 3. Fan-out / fan-in with list[job[int]]
    dim jobs = list[job[int]]()
    jobs.push(start doubleVal(5))
    jobs.push(start doubleVal(10))
    jobs.push(start doubleVal(15))
    dim sum = 0
    for j in jobs
        sum = sum + j.wait()
    end for
    print("pool sum=" + sum.toStr())

    // 4. Returning list[T] and dict[K, V] from job[T]
    dim listJob = start makeScaledList(10)
    dim items = listJob.wait()
    print("list_ret=" + items.len().toStr() + ":" + (items[0] + items[1] + items[2]).toStr())

    dim pair = BoxedPair(20, 22)
    dim dictJob = start buildSummary(pair)
    pair.a = 999
    dim summary = dictJob.wait()
    print("dict_ret=" + summary.len().toStr() + ":" + summary.get("sum", 0).toStr())

    // 5. Eager value-copy isolation after start
    dim n = 99
    dim eagerJob = start addOne(n)
    n = 1
    print("eager=" + eagerJob.wait().toStr())

    // 6. Zero-initialized job.wait() safety and idempotent repeated .wait()
    dim nilJob as job[int]
    print("zero_wait=" + nilJob.wait().toStr())

    dim repJob = start doubleVal(21)
    print("repeat=" + repJob.wait().toStr() + ":" + repJob.wait().toStr())

    // 7. Void job
    dim vj as job
    vj = start touchVoid()
    vj.wait()
    vj.wait()
    print("void_done=true")

    // 8. job.isDone() on zero-initialized and completed jobs
    print("is_done=" + nilJob.isDone().toStr() + ":" + repJob.isDone().toStr())

    // 9. job.waitTimeout(ms) succeeding on fast typed and void jobs
    dim fastJob = start doubleVal(21)
    dim fastVoid = start touchVoid()
    try
        dim fastRes = fastJob.waitTimeout(5000)
        fastVoid.waitTimeout(5000)
        print("fast_timeout=" + fastRes.toStr() + ":void_ok")
    catch e
        print("fast_timeout_err=" + e.msg)
    end try

    // 10. Cooperative cancellation + deterministic waitTimeout + idempotent cancel()
    dim tok as cancelToken
    dim slowJob = start waitForCancel(tok)
    dim beforeDone = slowJob.isDone()
    dim timedOut = false
    try
        dim unused = slowJob.waitTimeout(15)
    catch e
        timedOut = true
        tok.cancel()
        tok.cancel()
    end try
    dim slowRes = slowJob.wait()
    print("cancel_timeout=" + beforeDone.toStr() + ":" + timedOut.toStr() + ":" + slowRes.toStr() + ":" + slowJob.isDone().toStr())

    // 11. Fan-out cancellation via zero-initialized cancelToken inside value struct
    dim cfg = WorkerConfig(11, cancelToken())
    dim cfg2 = WorkerConfig()
    cfg2.id = 21
    cfg2.tok = cfg.tok
    dim w1 = start fanoutWorker(cfg)
    dim w2 = start fanoutWorker(cfg2)
    cfg.tok.cancel()
    print("fanout_cancel=" + cfg.tok.isCanceled().toStr() + ":" + w1.wait().toStr() + ":" + w2.wait().toStr())

    return 0
end fn
