' EXPECT_OUT: goInterop=14:HELLO
' EXPECT_OUT: sliceStr=ell:he:lo:hello:
' EXPECT_OUT: sliceList=2,3:1,2:4,5:0
' EXPECT_OUT: bytes=65:66:ABC:65,66,67:0
' EXPECT_OUT: loopList=0=10,1=20,2=30
' EXPECT_OUT: loopStr=a,b,é|0:a,1:b,2:é
' EXPECT_OUT: interp=sum=7,q="hi",len=5
' EXPECT_OUT: fsExtra=a/b:true:true:false

import "std/fs"
import "std/os"

go import "strings" as gostrings

go
func cbTestAddTen(v int64) int64 {
	return v + 10
}
end go

fn addTen(v as int) as int = go "cbTestAddTen"
fn upperGo(s as str) as str = go "gostrings.ToUpper"

fn main() as int
	print("goInterop=" & addTen(4) & ":" & upperGo("hello"))

	dim s = "hello"
	print("sliceStr=" & s[1:4] & ":" & s[:2] & ":" & s[3:] & ":" & s[-5:99] & ":" & s[4:2])

	dim nums = [1, 2, 3, 4, 5]
	dim s1 = nums[1:3]
	dim s2 = nums[:2]
	dim s3 = nums[3:]
	dim s4 = nums[4:2]
	print("sliceList=" & s1[0] & "," & s1[1] & ":" & s2[0] & "," & s2[1] & ":" & s3[0] & "," & s3[1] & ":" & s4.len())

	dim b = 65.toByte()
	dim b2 = b + 1.toByte()
	dim bs = [b, b2, 67.toByte()]
	dim word = str.fromBytes(bs)
	dim raw = word.toBytes()
	print("bytes=" & b.toInt() & ":" & b2.toInt() & ":" & word & ":" & raw[0].toInt() & "," & raw[1].toInt() & "," & raw[2].toInt() & ":" & s[99].toInt())

	dim listParts = list[str]()
	for i, v in [10, 20, 30]
		listParts.push("" & i & "=" & v)
	end for
	print("loopList=" & str.join(listParts, ","))

	dim runes1 = list[str]()
	for ch in "abé"
		runes1.push(ch)
	end for
	dim runes2 = list[str]()
	for bi, ch in "abé"
		runes2.push("" & bi & ":" & ch)
	end for
	print("loopStr=" & str.join(runes1, ",") & "|" & str.join(runes2, ","))

	dim a = 3
	dim c = 4
	print("interp=sum=" & (a + c) & ",q=" & str.quote("hi") & ",len=" & s.len())

	dim cleaned = fs.clean("a/./b")
	try
		dim tmp = fs.mkdirTemp("cb_tier1_*")
		dim absTmp = fs.abs(tmp)
		dim isAbsNonEmpty = absTmp.len() > 0
		fs.removeAll(tmp)
		print("fsExtra=" & cleaned & ":" & isAbsNonEmpty & ":" & (not fs.exists(tmp)) & ":" & (str.fromCharCode(65) == "B"))
	catch e
		os.eprintln("unexpected fs error: " & e.msg)
		return 1
	end try

	return 0
end fn
