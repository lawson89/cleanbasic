// EXPECT_OUT: goInterop=14:HELLO
// EXPECT_OUT: sliceStr=ell:he:lo:hello
// EXPECT_OUT: sliceList=2,3:1,2:4,5:5
// EXPECT_OUT: bytes=65:66:65,66,67
// EXPECT_OUT: byteLit=65:10:39:0:upperA
// EXPECT_OUT: loopList=0=10,1=20,2=30
// EXPECT_OUT: loopStr=a,b,é|0:a,1:b,2:é
// EXPECT_OUT: interp=sum=7,q="hi",len=5
// EXPECT_OUT: fsExtra=a/b:true:true:false

import "std/fs"
import "std/os"

go import "strings" as gostrings

go
func cbTestAddTen(v int64) int64 {
	return v + 10
}
end go

/// Byte literal top-level constant
const BYTE_A = 'A'

fn classifyByte(ch as byte) as str
	select case ch
		case BYTE_A
			return "upperA"
		case else
			return "other"
	end select
end fn

fn addTen(v as int) as int = go "cbTestAddTen"
fn upperGo(s as str) as str = go "gostrings.ToUpper"

fn main() as int
	print("goInterop=" + addTen(4).toStr() + ":" + upperGo("hello"))

	dim s = "hello"
	print("sliceStr=" + s[1:4] + ":" + s[:2] + ":" + s[3:] + ":" + s[:])

	dim nums = [1, 2, 3, 4, 5]
	dim s1 = nums[1:3]
	dim s2 = nums[:2]
	dim s3 = nums[3:]
	dim s4 = nums[:]
	print("sliceList=" + s1[0].toStr() + "," + s1[1].toStr() + ":" + s2[0].toStr() + "," + s2[1].toStr() + ":" + s3[0].toStr() + "," + s3[1].toStr() + ":" + s4.len().toStr())

	dim b = 65.toByte()
	dim b2 = b + 1.toByte()
	dim bs = [b, b2, 67.toByte()]
	print("bytes=" + b.toInt().toStr() + ":" + b2.toInt().toStr() + ":" + bs[0].toInt().toStr() + "," + bs[1].toInt().toStr() + "," + bs[2].toInt().toStr())

	dim litA = 'A'
	dim litNl = '\n'
	dim litSq = '\''
	dim litNul = '\0'
	print("byteLit=" + litA.toInt().toStr() + ":" + litNl.toInt().toStr() + ":" + litSq.toInt().toStr() + ":" + litNul.toInt().toStr() + ":" + classifyByte(litA))

	dim listParts = list[str]()
	for i, v in [10, 20, 30]
		listParts.push(i.toStr() + "=" + v.toStr())
	end for
	print("loopList=" + str.join(listParts, ","))

	dim runes1 = list[str]()
	for ch in "abé"
		runes1.push(ch)
	end for
	dim runes2 = list[str]()
	for bi, ch in "abé"
		runes2.push(bi.toStr() + ":" + ch)
	end for
	print("loopStr=" + str.join(runes1, ",") + "|" + str.join(runes2, ","))

	dim a = 3
	dim c = 4
	print("interp=sum=" + (a + c).toStr() + ",q=" + str.quote("hi") + ",len=" + s.len().toStr())

	dim cleaned = fs.clean("a/./b")
	try
		dim tmp = fs.mkdirTemp("cb_tier1_*")
		dim absTmp = fs.abs(tmp)
		dim isAbsNonEmpty = absTmp.len() > 0
		fs.removeAll(tmp)
		print("fsExtra=" + cleaned + ":" + isAbsNonEmpty.toStr() + ":" + (not fs.exists(tmp)).toStr() + ":" + (str.fromCharCode(65) == "B").toStr())
	catch e
		os.eprintln("unexpected fs error: " + e.msg)
		return 1
	end try

	return 0
end fn
