import "../entities/hero.cb" as h

public type Stats
    hits as int
end type

public enum OutcomeKind
    Hit
    Blocked
end enum

public type Outcome
    kind as OutcomeKind
    dmg as int
    reason as str
end type

public fn describe(s as Stats) as str
    return "hits=" + s.hits.toStr()
end fn

public fn strike(byref target as h.Hero, dmg as int) as Outcome
    target.stats.hp = target.stats.hp - dmg
    if target.stats.hp < 0
        target.stats.hp = 0
    end if
    if dmg <= 0
        return Outcome(OutcomeKind.Blocked, 0, "zero")
    end if
    return Outcome(OutcomeKind.Hit, dmg, "")
end fn
