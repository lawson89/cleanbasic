import "std/cli"
import "std/fs"
import "std/os"
import "std/regex"

const MAX_PARALLEL_JOBS = 16

type GrepConfig
    fixedNeedle as str
    ignoreCase as bool
    lineNumber as bool
    countOnly as bool
    invertMatch as bool
    fixedStrings as bool
    showFilename as bool
    quiet as bool
    re as regex.Regex
end type

type SearchTask
    filePath as str
    regexPattern as str
    fixedNeedle as str
    ignoreCase as bool
    lineNumber as bool
    countOnly as bool
    invertMatch as bool
    fixedStrings as bool
    showFilename as bool
    quiet as bool
    tok as cancelToken
end type

type FileSearchResult
    outputLines as list[str]
    matches as int
    errMsg as str
    canceled as bool
end type

fn lineMatches(cfg as GrepConfig, line as str) as bool
    dim matched = false
    if cfg.fixedStrings
        if cfg.ignoreCase
            matched = line.toLower().contains(cfg.fixedNeedle)
        else
            matched = line.contains(cfg.fixedNeedle)
        end if
    else
        matched = cfg.re.isMatch(line)
    end if
    if cfg.invertMatch
        return not matched
    end if
    return matched
end fn

fn searchLines(cfg as GrepConfig, label as str, content as str, tok as cancelToken, byref outLines as list[str], byref canceled as bool) as int
    dim normalized = content.replace("\r\n", "\n")
    if normalized.len() == 0
        if cfg.countOnly and not cfg.quiet
            if cfg.showFilename
                outLines.push(label + ":0")
            else
                outLines.push("0")
            end if
        end if
        return 0
    end if

    dim lines = normalized.split("\n")
    dim limit = lines.len()
    if normalized.endsWith("\n") and limit > 0
        limit = limit - 1
    end if

    dim matches = 0
    for idx = 0 to limit - 1
        if tok.isCanceled()
            canceled = true
            return matches
        end if
        dim line = lines[idx]
        if lineMatches(cfg, line)
            matches = matches + 1
            if cfg.quiet
                tok.cancel()
                return matches
            end if
            if not cfg.countOnly
                dim prefix = ""
                if cfg.showFilename
                    prefix = prefix + label + ":"
                end if
                if cfg.lineNumber
                    prefix = prefix + (idx + 1).toStr() + ":"
                end if
                outLines.push(prefix + line)
            end if
        end if
    end for

    if cfg.countOnly and not cfg.quiet
        if cfg.showFilename
            outLines.push(label + ":" + matches.toStr())
        else
            outLines.push(matches.toStr())
        end if
    end if
    return matches
end fn

fn searchFileWorker(task as SearchTask) as FileSearchResult
    if task.tok.isCanceled()
        return FileSearchResult(list[str](), 0, "", true)
    end if

    dim content = ""
    try
        content = fs.readFile(task.filePath)
    catch e
        return FileSearchResult(list[str](), 0, e.msg, false)
    end try

    dim cfg = GrepConfig()
    cfg.fixedNeedle = task.fixedNeedle
    cfg.ignoreCase = task.ignoreCase
    cfg.lineNumber = task.lineNumber
    cfg.countOnly = task.countOnly
    cfg.invertMatch = task.invertMatch
    cfg.fixedStrings = task.fixedStrings
    cfg.showFilename = task.showFilename
    cfg.quiet = task.quiet

    if not cfg.fixedStrings
        try
            cfg.re = regex.compile(task.regexPattern)
        catch e
            return FileSearchResult(list[str](), 0, e.msg, false)
        end try
    end if

    dim outLines = list[str]()
    dim canceled = false
    dim matches = searchLines(cfg, task.filePath, content, task.tok, outLines, canceled)
    return FileSearchResult(outLines, matches, "", canceled)
end fn

fn collectFiles(target as str, recursive as bool, byref outFiles as list[str]) can error
    if fs.isDir(target)
        if not recursive
            error("cbgrep: " + target + ": is a directory (use -r for recursive search)")
        end if
        dim entries = fs.listDir(target)
        for entry in entries
            if entry == ".git"
                continue
            end if
            dim fullPath = fs.join(target, entry)
            if fs.isDir(fullPath)
                if not fs.isSymlink(fullPath)
                    collectFiles(fullPath, recursive, outFiles)
                end if
            else
                outFiles.push(fullPath)
            end if
        end for
        return
    end if
    if not fs.exists(target)
        error("cbgrep: " + target + ": no such file or directory")
    end if
    outFiles.push(target)
end fn

fn main() as int
    dim p = cli.newParser("cbgrep", "1.0.0", "Search for patterns in files or standard input")
    p.addFlag("ignore-case", "i", "Ignore case distinctions")
    p.addFlag("line-number", "n", "Prefix each line of output with the 1-based line number")
    p.addFlag("count", "c", "Print only a count of matching lines per file")
    p.addFlag("invert-match", "v", "Select non-matching lines")
    p.addFlag("fixed-strings", "F", "Interpret pattern as a fixed literal string")
    p.addFlag("recursive", "r", "Recursively search directories")
    p.addFlag("quiet", "q", "Suppress normal output; exit 0 on first match")
    p.addOption("timeout", "t", "Maximum wait time in milliseconds per batch (0 = no timeout)", "0")
    p.addArg("pattern", "Pattern to search for")

    dim parsed = cli.ParsedArgs()
    try
        parsed = p.parseArgs(os.args())
    catch e
        print("cbgrep: " + e.msg)
        return 2
    end try

    if parsed.helpRequested
        p.printUsage()
        return 0
    end if

    dim pattern = parsed.getArg("pattern")
    dim ignoreCase = parsed.hasFlag("ignore-case")
    dim lineNumber = parsed.hasFlag("line-number")
    dim countOnly = parsed.hasFlag("count")
    dim invertMatch = parsed.hasFlag("invert-match")
    dim fixedStrings = parsed.hasFlag("fixed-strings")
    dim recursive = parsed.hasFlag("recursive")
    dim quiet = parsed.hasFlag("quiet")

    dim timeoutMs = 0
    try
        timeoutMs = parsed.getOption("timeout").toInt()
    catch e
        print("cbgrep: invalid --timeout value: " + parsed.getOption("timeout"))
        return 2
    end try
    if timeoutMs < 0
        print("cbgrep: invalid --timeout value (must be >= 0)")
        return 2
    end if

    dim cfg = GrepConfig()
    cfg.ignoreCase = ignoreCase
    cfg.lineNumber = lineNumber
    cfg.countOnly = countOnly
    cfg.invertMatch = invertMatch
    cfg.fixedStrings = fixedStrings
    cfg.showFilename = false
    cfg.quiet = quiet

    dim regexPattern = pattern
    if fixedStrings
        if ignoreCase
            cfg.fixedNeedle = pattern.toLower()
        else
            cfg.fixedNeedle = pattern
        end if
    else
        if ignoreCase
            regexPattern = "(?i)" + pattern
        end if
        try
            cfg.re = regex.compile(regexPattern)
        catch e
            print("cbgrep: invalid regex: " + e.msg)
            return 2
        end try
    end if

    dim targets = list[str]()
    dim posCount = parsed.positionals.len()
    if posCount > 1
        for i = 1 to posCount - 1
            targets.push(parsed.positionals[i])
        end for
    end if

    dim tok = cancelToken()

    if targets.len() == 0
        try
            dim stdinText = os.readStdin()
            dim outLines = list[str]()
            dim canceled = false
            dim matched = searchLines(cfg, "(standard input)", stdinText, tok, outLines, canceled)
            if not quiet
                for line in outLines
                    print(line)
                end for
            end if
            if matched > 0
                return 0
            end if
            return 1
        catch e
            print("cbgrep: failed reading stdin: " + e.msg)
            return 2
        end try
    end if

    dim files = list[str]()
    try
        for target in targets
            collectFiles(target, recursive, files)
        end for
    catch e
        print(e.msg)
        return 2
    end try

    if files.len() > 1 or recursive
        cfg.showFilename = true
    end if

    dim totalMatches = 0
    dim idx = 0
    while idx < files.len()
        if tok.isCanceled()
            break
        end if

        dim batchEnd = idx + MAX_PARALLEL_JOBS
        if batchEnd > files.len()
            batchEnd = files.len()
        end if

        dim batch = list[job[FileSearchResult]]()
        for k = idx to batchEnd - 1
            dim task = SearchTask(files[k], regexPattern, cfg.fixedNeedle, cfg.ignoreCase, cfg.lineNumber, cfg.countOnly, cfg.invertMatch, cfg.fixedStrings, cfg.showFilename, cfg.quiet, tok)
            batch.push(start searchFileWorker(task))
        end for

        for k = 0 to batch.len() - 1
            dim j = batch[k]
            dim res = FileSearchResult()
            if timeoutMs > 0
                try
                    res = j.waitTimeout(timeoutMs)
                catch e
                    tok.cancel()
                    print("cbgrep: search timed out after " + timeoutMs.toStr() + "ms")
                    return 2
                end try
            else
                res = j.wait()
            end if

            if res.errMsg != ""
                tok.cancel()
                print("cbgrep: " + files[idx + k] + ": " + res.errMsg)
                return 2
            end if

            if not quiet
                for outLine in res.outputLines
                    print(outLine)
                end for
            end if
            totalMatches = totalMatches + res.matches
        end for

        idx = batchEnd
    end while

    if totalMatches > 0
        return 0
    end if
    return 1
end fn
