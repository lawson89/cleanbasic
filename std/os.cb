go import "bytes"
go import "errors"
go import "fmt"
go import "io"
go import "os"
go import "os/exec"

public type ExecResult
	exitCode as int
	stdout as str
	stderr as str
end type

go
func cbStdOsArgs() []string {
	if len(os.Args) <= 1 {
		return nil
	}
	return os.Args[1:]
}

func cbStdOsExit(code int64) {
	os.Exit(int(code))
}

func cbStdOsExec(cmd string, args []string) (std_os__ExecResult, error) {
	c := exec.Command(cmd, args...)
	var outBuf, errBuf bytes.Buffer
	c.Stdout = &outBuf
	c.Stderr = &errBuf
	err := c.Run()
	var exitCode int64
	if err != nil {
		var exitErr *exec.ExitError
		if errors.As(err, &exitErr) {
			exitCode = int64(exitErr.ExitCode())
			err = nil
		}
	}
	return std_os__ExecResult{
		exitCode: exitCode,
		stdout:   outBuf.String(),
		stderr:   errBuf.String(),
	}, err
}

func cbStdOsReadStdin() (string, error) {
	data, err := io.ReadAll(os.Stdin)
	if err != nil {
		return "", err
	}
	return string(data), nil
}

func cbStdOsEprint(msg string) {
	fmt.Fprint(os.Stderr, msg)
}

func cbStdOsEprintln(msg string) {
	fmt.Fprintln(os.Stderr, msg)
}

func cbStdOsWriteStdout(msg string) {
	fmt.Fprint(os.Stdout, msg)
}

func cbStdOsExecInDir(dir string, cmd string, args []string) (int64, error) {
	c := exec.Command(cmd, args...)
	if dir != "" {
		c.Dir = dir
	}
	c.Stdin = os.Stdin
	c.Stdout = os.Stdout
	c.Stderr = os.Stderr
	err := c.Run()
	if err != nil {
		var exitErr *exec.ExitError
		if errors.As(err, &exitErr) {
			return int64(exitErr.ExitCode()), nil
		}
		return 0, err
	}
	return 0, nil
}

func cbStdOsCacheDir() string {
	dir, err := os.UserCacheDir()
	if err != nil || dir == "" {
		return os.TempDir()
	}
	return dir
}
end go

public fn args() as list[str] = go "cbStdOsArgs"
public fn exit(code as int) = go "cbStdOsExit"
public fn getEnv(key as str) as str = go "os.Getenv"
public fn exec(cmd as str, args as list[str]) as ExecResult can error = go "cbStdOsExec"
public fn readStdin() as str can error = go "cbStdOsReadStdin"
public fn cwd() as str can error = go "os.Getwd"
public fn eprint(msg as str) = go "cbStdOsEprint"
public fn eprintln(msg as str) = go "cbStdOsEprintln"
public fn writeStdout(msg as str) = go "cbStdOsWriteStdout"
public fn execInDir(dir as str, cmd as str, args as list[str]) as int can error = go "cbStdOsExecInDir"
public fn cacheDir() as str = go "cbStdOsCacheDir"
public fn executable() as str can error = go "os.Executable"
