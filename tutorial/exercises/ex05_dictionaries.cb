fn main()
    dim text = "go basic go clean basic go"
    dim counts = dict[str, int]()
    dim queries = ["go", "basic", "clean", "rust"]

    // TODO: Split text on " ", count word occurrences in counts,
    // and print each query with its count
    for q in queries
        print(q + ": " + counts.get(q, 0).toStr())
    end for
end fn
